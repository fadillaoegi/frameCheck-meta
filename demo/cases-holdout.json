    { "id": "h-clip-plan-title-3", "variant": "h-clip-plan-title-3", "split": "holdout", "category": "clipped_text", "component": "plan-title-3", "decidable": true },
    { "id": "h-clip-banner-text", "variant": "h-clip-banner-text", "split": "holdout", "category": "clipped_text", "component": "banner-text", "decidable": true },
