# Copy to .env for local development; .env is ignored by Git.
FRAMECHECK_DB_PASSWORD=replace-with-a-local-only-password
FRAMECHECK_DB_PORT=5440
FRAMECHECK_API_PORT=8089
FRAMECHECK_WEB_PORT=5181
FRAMECHECK_DATABASE_URL=postgres://framecheck:replace-with-a-local-only-password@127.0.0.1:5440/framecheck?sslmode=disable
FRAMECHECK_STORAGE_DIR=./storage

# Analysis provider: mock (pixel-difference heuristic), fixture (replays
# demo/fixtures ground truth for those exact images), or meta (Muse Spark; billable,
# also needs MODEL_API_ENABLED=true and a key). mock and fixture never use the network.
FRAMECHECK_PROVIDER=mock
FRAMECHECK_FIXTURES_DIR=../demo/fixtures,../demo/fixtures-holdout

# Keep inference disabled until rules, entitlement, and credits are verified.
# Never put a real key in this example or expose it to the browser.
MODEL_API_ENABLED=false
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_API_SPARK_MODEL=muse-spark-1.3
MODEL_API_SAM_MODEL=sam-3.1
# Local hard stop on billable calls per server process (Meta's spend limit is only an alert).
MODEL_API_MAX_REQUESTS=20
MODEL_API_MAX_IMAGE_SIDE=2048
MODEL_API_MAX_OUTPUT_TOKENS=4000
